{
  "name": "dopagakix",
  "version": "0.1.0",
  "description": "AI エージェント(Claude Code)が書いた作業報告から、指示者向けの縦型動画(9:16 mp4)を作る CLI とスキル",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4rtoflow/Dopagakix.git"
  },
  "bin": {
    "dopagakix": "dist/cli.js"
  },
  "files": [
    "dist",
    ".claude/skills/video-report",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-serif-jp": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "commander": "^15.0.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
